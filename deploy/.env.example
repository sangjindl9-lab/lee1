# ───── SS-ERP 설치 설정 ─────
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 외부에 공유하지 마세요.

# 접속 주소 (DNS가 이 서버를 가리켜야 HTTPS 인증서가 자동 발급됩니다)
ERP_DOMAIN=erp.example.co.kr
ACME_EMAIL=it@example.co.kr

# 데이터베이스 비밀번호 — 긴 무작위 문자열
#   생성: openssl rand -base64 32
DB_PASSWORD=

# 필드 암호화 키 (계좌번호·2단계 인증 비밀키) — 64자리 16진수
#   생성: openssl rand -hex 32
#   ※ 분실하면 암호화된 계좌번호를 복구할 수 없습니다. 안전한 곳에 따로 보관하세요.
APP_ENCRYPTION_KEY=

# 첫 실행 시 만들 회사와 최고관리자 (회사가 이미 있으면 무시됨)
INIT_COMPANY_NAME=㈜에스에스전력
INIT_COMPANY_BIZNO=
INIT_COMPANY_CODE=SS
INIT_ADMIN_ID=admin
# 10자 이상, 영문 대·소문자·숫자·특수문자 중 3종. 첫 로그인 때 변경을 요구합니다.
INIT_ADMIN_PASSWORD=

# 백업 — backup 컨테이너가 매일 BACKUP_HOUR 시에 DB·첨부파일을 BACKUP_DIR 에 저장
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
BACKUP_HOUR=3
# 화면(관리 > 백업)에서 만든 수동 백업 보관 개수 (app-backups 볼륨)
BACKUP_KEEP_MANUAL=10

# API 문서(/api/docs)를 운영에서 열지 여부 — 외부 프로그램 연동 개발 기간에만 true 권장
SWAGGER_ENABLED=false

# 공급사에서 받은 설치 코드 — 넣어 두면 연장·변경된 라이선스가 자동으로 들어옵니다 (화면 '관리 > 라이선스'에서 넣어도 됨)
LICENSE_ACTIVATION_CODE=
# 인터넷이 안 되는 서버만: 아래 줄의 주석을 풀어 온라인 확인을 끄고, 라이선스 문자열을 화면에서 직접 등록
# LICENSE_SERVER_URL=

# 라이선스 공개키 교체 시에만 (base64 로 인코딩한 PEM)
LICENSE_PUBLIC_KEY=

# 외부 연동 키(팝빌·CODEF·공공데이터포털·OCR)는 이 파일에 넣지 않습니다.
# 설치 후 화면의 '관리 > 외부 연동' 에서 입력하면 APP_ENCRYPTION_KEY 로 암호화되어 저장됩니다.

# PostgreSQL 접속 주소. 비워 두면 내장 Postgres(PGlite)를 DATA_DIR 아래에 만든다(개발·시험용)
DATABASE_URL=postgresql://eum:password@localhost:5432/eum_market
# 납품물 저장소와 내장 DB가 놓이는 폴더. 배포 시 영구 볼륨에 연결
DATA_DIR=./data

# 아래 세 값은 운영에서 필수. openssl rand -hex 32 로 만든다
SESSION_SECRET=
FILE_MASTER_KEY=
SIMPG_WEBHOOK_SECRET=

# 처음 실행할 때 만들 최고관리자
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 결제 사업자. 지금은 test(시뮬레이터)만 지원
PAYMENT_PROVIDER=test
# 납품물 저장소. 지금은 local 만 지원
STORAGE=local
# 구매 후 납품물 접근 기간(일), 업로드 제한(MB)
RETENTION_DAYS=365
MAX_UPLOAD_MB=200
# 외부 스케줄러가 /api/jobs 를 호출할 때 쓰는 값(선택). 서버 안에서도 1분마다 자동 실행된다
JOBS_SECRET=

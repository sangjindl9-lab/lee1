# EUM 3D STUDIO PRO 환경변수 예제
PORT=8080
NODE_ENV=production
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eum3d
# 세션·공유·렌더 토큰 서명키 (운영 필수, 32바이트 이상 무작위 문자열)
JWT_SECRET=change-me-to-a-long-random-string
# 업로드 원본·변환 모델·영상 저장 위치 (Docker 볼륨 경로)
DATA_DIR=/data
# 공유 링크·QR 에 쓰일 외부 주소 (없으면 요청 Host 사용)
PUBLIC_URL=https://showroom.example.com
# 이 인스턴스에서 변환·렌더 작업자 실행 여부 (전용 렌더 워커를 따로 둘 때 웹 서버는 false)
RUN_WORKER=true
# 렌더 워커가 앱에 접속할 내부 주소 (기본 http://127.0.0.1:$PORT)
# INTERNAL_URL=http://app:8080
# 헤드리스 Chromium 경로 (Docker 이미지에는 포함, 직접 설치 시 지정)
# CHROMIUM_PATH=/usr/bin/chromium
MAX_UPLOAD_MB=1024
MAX_RENDER_SECONDS=120
# 2D 도면 업로드 즉시 참고용 AI 3D 초안 자동 생성 (끄려면 false)
AUTO_DRAFT=true
# Tesseract OCR 실행 파일 (스캔·이미지 도면 글자 인식, 없으면 OCR 없이 진행)
# TESSERACT_PATH=/usr/bin/tesseract

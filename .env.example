# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (cp .env.example .env)

# KIS Developers(apiportal.koreainvestment.com)에서 발급
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=12345678     # 계좌번호 앞 8자리
KIS_ACCOUNT_PROD=01         # 계좌번호 뒤 2자리
KIS_ENV=real                # real(실전) | virtual(모의투자)

# ★ 안전장치: NO 이면 주문이 실제로 나가지 않고 로그만 남습니다.
#   며칠 돌려보고 로그가 납득될 때 YES 로 바꾸세요.
LIVE_TRADING=NO

# 매매 대상 종목코드 (쉼표 구분)
UNIVERSE=005930,000660,373220,207940,005380,000270,068270,105560,035420,055550,005490,035720

# 리스크 관리
MAX_POSITIONS=3
MAX_ORDER_KRW=300000
STOP_LOSS=-0.05
TAKE_PROFIT=0.08
DAILY_LOSS_LIMIT_KRW=100000

# 모델
HORIZON=5
TARGET_RET=0.01
BUY_THRESHOLD=0.60
SELL_THRESHOLD=0.40
SELL_TAX=0.002

# 웹 대시보드
#   비워두면 이 컴퓨터(localhost)에서만 접속됩니다.
#   휴대폰 등 다른 기기에서 보려면 비밀번호를 정하세요.
WEB_PASSWORD=
WEB_PORT=8000

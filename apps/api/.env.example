# SS-ERP API 개발용 환경설정 — 운영은 deploy/.env.example 사용
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp

# 필드 암호화 키 (64자리 16진수) — openssl rand -hex 32
APP_ENCRYPTION_KEY=

WEB_ORIGIN=http://localhost:3000
# 개발(http)에서만 false. 운영은 반드시 true (HTTPS)
COOKIE_SECURE=false
TRUST_PROXY=false

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15

FILE_STORAGE=local
FILE_STORAGE_PATH=./storage
FILE_MAX_MB=20

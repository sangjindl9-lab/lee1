# 서버
PORT=3100
DATA_DIR=./data
# 관리자 비밀번호를 넣으면 로그인 화면이 생깁니다 (권장: 배포 시 설정)
ADMIN_PASSWORD=
# 세션 쿠키 서명 키 (ADMIN_PASSWORD 를 쓰면 반드시 별도 값으로 지정)
AUTH_SECRET=

# Google Play 수집
PLAY_LANG=ko
PLAY_COUNTRY=KR
PLAY_TIMEOUT_MS=20000
# 순위 탐색 깊이 (5~50). Play 웹 검색은 한 페이지에 30개를 내려줍니다.
RANK_DEPTH=30

# 선택: OpenAI (없으면 템플릿 엔진으로 동작)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 첫 실행 시 이음소프트웨어 앱 3개를 시드로 넣을지 (0=끄기)
SEED_DEMO=1
# 내장 스케줄러 사용 여부 (0=끄기)
SCHEDULER=1

# 쇼츠 스튜디오 (YouTube Shorts 풀오토)
# ffmpeg/ffprobe 경로 (Docker 이미지에는 설치되어 있어 비워둡니다)
FFMPEG_PATH=
FFPROBE_PATH=
SHORTS_DIR=
SHORTS_FONT=Noto Sans CJK KR
# 외부 AI 프로바이더 키 (설정 화면에서 저장하거나 환경변수로 지정)
HIGGSFIELD_API_KEY=
ELEVENLABS_API_KEY=

-11-17","last_seen":null},{"sha256":"fb1007c60175887cf25433c941fd2b440e24206902c32414d271b7f4bd76a89d","threat_name":"GhostBat","threat_family":"GhostBat","category":"MALWARE","severity":"HIGH","confidence":95,"source":"MalwareBazaar (abuse.ch)","first_seen":"2026-11-17","last_seen":null}],"yara":[{"name":"EUM_TEST_Marker","body":"// EUM SECURITY PRO \ud14c\uc2a4\ud2b8 \uaddc\uce59 (\uc6b4\uc601 \ud0d0\uc9c0 \uc544\ub2d8). \ubb34\ud574\ud55c \ud14c\uc2a4\ud2b8 \ud53d\uc2a4\ucc98 \uac80\uc99d\uc6a9.\nrule EUM_TEST_Marker : test\n{\n    meta:\n        severity = \"HIGH\"\n        confidence = 100\n        description = \"EUM SECURITY PRO \ubb34\ud574\ud55c \ud14c\uc2a4\ud2b8 \ub9c8\ucee4\"\n    strings:\n        $m = \"EUM-SECURITY-TEST-MALWARE-MARKER-0001\"\n    condition:\n        $m\n}\n\n// \uc5c5\uacc4 \ud45c\uc900 \uc548\ud2f0\ubc14\uc774\ub7ec\uc2a4 \ud14c\uc2a4\ud2b8 \ud30c\uc77c(EICAR) \uc55e\ubd80\ubd84 \u2014 \uc804\uccb4 \ubb38\uc790\uc5f4\uc740 \ub123\uc9c0 \uc54a\ub294\ub2e4.\nrule EUM_TEST_EICAR_Prefix : test\n{\n    meta:\n        severity = \"HIGH\"\n        confidence = 100\n        description = \"EICAR \uc548\ud2f0\ubc14\uc774\ub7ec\uc2a4 \ud14c\uc2a4\ud2b8 \ud30c\uc77c\"\n    strings:\n        $e = { 58 35 4F 21 50 25 40 41 50 5B 34 5C 50 5A 58 35 34 28 50 5E 29 37 43 43 29 37 7D 24 45 49 43 41 52 }\n    condition:\n        $e at 0\n}\n","severity":"HIGH","confidence":100,"source":"EUM \ud14c\uc2a4\ud2b8 \ub370\uc774\ud130","license":"Apache-2.0","test":true},{"name":"EUM_TEST_EICAR_Prefix","body":"// (\uac19\uc740 \ud30c\uc77c\uc5d0 \ud3ec\ud568\ub428)\n","severity":"HIGH","confidence":100,"source":"EUM \ud14c\uc2a4\ud2b8 \ub370\uc774\ud130","license":"Apache-2.0","test":true},{"name":"EUM_HEUR_Accessibility_Overlay_SMS_Banker","body":"// EUM \uc790\uccb4 \ud734\ub9ac\uc2a4\ud2f1 \uaddc\uce59 v1 \u2014 \uc758\uc2ec \uadfc\uac70(\uc8fc\uc758) \uc6a9\ub3c4. \uc545\uc131 \ud655\uc815 \ud310\uc815\uc5d0 \uc4f0\uc9c0 \uc54a\ub294\ub2e4 (confidence \u2264 50).\nimport \"dex\"\n\nrule EUM_HEUR_Accessibility_Overlay_SMS_Banker\n{\n    meta:\n        severity = \"MEDIUM\"\n        confidence = 45\n        description = \"\uc811\uadfc\uc131 \uc81c\uc2a4\ucc98 \uc81c\uc5b4 + \ud654\uba74 \ub36e\uae30 + \ubb38\uc790 \ubc1c\uc1a1 \ucf54\ub4dc\uac00 \ud55c DEX \uc5d0 \ud568\uaed8 \uc788\uc74c (\uae08\uc735 \ud2b8\ub85c\uc774\ubaa9\ub9c8\uc5d0\uc11c \ud754\ud55c \uc870\ud569)\"\n    strings:\n        $a1 = \"dispatchGesture\"\n        $a2 = \"performGlobalAction\"\n        $a3 = \"getRootInActiveWindow\"\n        $o1 = \"TYPE_APPLICATION_OVERLAY\"\n        $s1 = \"sendTextMessage\"\n        $s2 = \"getMessageBody\"\n    condition:\n        dex.is_dex and 2 of ($a*) and $o1 and all of ($s*)\n}\n\nrule EUM_HEUR_Root_Exploit_Commands\n{\n    meta:\n        severity = \"MEDIUM\"\n        confidence = 50\n        description = \"\uc2dc\uc2a4\ud15c \ud30c\ud2f0\uc158\uc744 \uc4f0\uae30 \uac00\ub2a5\uc73c\ub85c \ub2e4\uc2dc \ub9c8\uc6b4\ud2b8\ud558\uace0 su \ub97c \uc124\uce58\ud558\ub294 \uba85\ub839 (\ub8e8\ud305 \uc775\uc2a4\ud50c\ub85c\uc787 \ud328\ud134)\"\n    strings:\n        $r1 = \"mount -o remount,rw /system\"\n        $r2 = \"/system/xbin/su\"\n        $r3 = \"chmod 4755\"\n        $r4 = \"chmod 6755\"\n    condition:\n        $r1 and $r2 and 1 of ($r3, $r4)\n}\n\nrule EUM_HEUR_Hide_Icon_Device_Admin_Lock\n{\n    meta:\n        severity = \"MEDIUM\"\n        confidence = 40\n        description = \"\ub7f0\ucc98 \uc544\uc774\ucf58 \uc228\uae40 + \uae30\uae30 \uad00\ub9ac\uc790 \uad8c\ud55c\uc73c\ub85c \ud654\uba74 \uc7a0\uae08/\ube44\ubc00\ubc88\ud638 \ubcc0\uacbd (\ub79c\uc12c\uc6e8\uc5b4\u00b7\uc2a4\ud30c\uc774\uc571 \ud328\ud134)\"\n    strings:\n        $h1 = \"setComponentEnabledSetting\"\n        $d1 = \"resetPassword\"\n        $d2 = \"lockNow\"\n        $d3 = \"ACTION_ADD_DEVICE_ADMIN\"\n    condition:\n        dex.is_dex and $h1 and $d3 and 1 of ($d1, $d2)\n}\n","severity":"MEDIUM","confidence":45,"source":"EUM \uc790\uccb4 \ud734\ub9ac\uc2a4\ud2f1 v1","license":"Apache-2.0","test":false},{"name":"EUM_HEUR_Root_Exploit_Commands","body":"// (\uac19\uc740 \ud30c\uc77c\uc5d0 \ud3ec\ud568\ub428)\n","severity":"MEDIUM","confidence":50,"source":"EUM \uc790\uccb4 \ud734\ub9ac\uc2a4\ud2f1 v1","license":"Apache-2.0","test":false},{"name":"EUM_HEUR_Hide_Icon_Device_Admin_Lock","body":"// (\uac19\uc740 \ud30c\uc77c\uc5d0 \ud3ec\ud568\ub428)\n","severity":"MEDIUM","confidence":40,"source":"EUM \uc790\uccb4 \ud734\ub9ac\uc2a4\ud2f1 v1","license":"Apache-2.0","test":false}],"patterns":[{"name":"EUM_TEST_Marker_P","severity":"HIGH","confidence":100,"source":"EUM \ud14c\uc2a4\ud2b8 \ub370\uc774\ud130","license":"Apache-2.0","test":true,"body":{"strings":["EUM-SECURITY-TEST-MALWARE-MARKER-0001"],"min":1,"targets":["any"],"description":"\ubb34\ud574\ud55c \ud14c\uc2a4\ud2b8 \ub9c8\ucee4"}},{"name":"EUM_HEUR_Accessibility_Overlay_SMS_Banker_P","severity":"MEDIUM","confidence":45,"source":"EUM \uc790\uccb4 \ud734\ub9ac\uc2a4\ud2f1 v1","license":"Apache-2.0","test":false,"body":{"strings":["dispatchGesture","TYPE_APPLICATION_OVERLAY","sendTextMessage","getMessageBody","getRootInActiveWindow"],"min":5,"targets":["dex"]}},{"name":"EUM_HEUR_Root_Exploit_Commands_P","severity":"MEDIUM","confidence":50,"source":"EUM \uc790\uccb4 \ud734\ub9ac\uc2a4\ud2f1 v1","license":"Apache-2.0","test":false,"body":{"strings":["mount -o remount,rw /system","/system/xbin/su","chmod 4755"],"min":3,"targets":["dex","so","other"]}},{"name":"EUM_HEUR_Hide_Icon_Device_Admin_Lock_P","severity":"MEDIUM","confidence":40,"source":"EUM \uc790\uccb4 \ud734\ub9ac\uc2a4\ud2f1 v1","license":"Apache-2.0","test":false,"body":{"strings":["setComponentEnabledSetting","ACTION_ADD_DEVICE_ADMIN","lockNow"],"min":3,"targets":["dex"]}}],"false_positives":[],"domains":{"phishing":["phishing-test.eum-security.invalid"],"malware":["malware-test.eum-security.invalid"]}}
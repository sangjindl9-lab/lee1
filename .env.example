# 복사: cp .env.example .env
KET_SECRET_KEY=반드시-32자-이상의-무작위-문자열로-교체
# 개발 기본: SQLite. 운영: PostgreSQL
# KET_DATABASE_URL=postgresql+psycopg://ket:ket@db:5432/ket
KET_STORAGE_DIR=./storage
KET_MAX_UPLOAD_MB=200
# DWG 변환기(적법한 라이선스 필요). 예: ODA File Converter
# KET_DWG_CONVERTER_CMD=/opt/ODAFileConverter/ODAFileConverter "$(dirname {in})" {out_dir} ACAD2018 DXF 0 1 "$(basename {in})"
# 외부 멀티모달 AI (선택). 서버에만 보관되며 브라우저에 노출되지 않음
# KET_ANTHROPIC_API_KEY=
# 작업 큐: thread(기본) | celery
KET_JOB_BACKEND=thread
# KET_REDIS_URL=redis://redis:6379/0
KET_CORS_ORIGINS=["http://localhost:8000"]

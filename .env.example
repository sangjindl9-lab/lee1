# ─────────────────────────────────────────────────────────────
# 데브볼트 (DevVault) 환경변수 예시
# 이 파일을 .env 로 복사해 사용하세요. 실제 비밀값은 절대 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────

# PostgreSQL 접속 문자열 (운영: SSL 사용 권장)
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/devvault?schema=public"

# 테스트 전용 DB (npm test 시 사용, 개발 DB와 반드시 분리)
TEST_DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/devvault_test?schema=public"

# 세션 서명·HMAC 키 (32바이트 이상 임의 문자열)
# 생성 예: openssl rand -base64 48
APP_SECRET="change-me-to-a-long-random-secret"

# 납품 파일 암호화 마스터 키 (AES-256-GCM 키 유도에 사용)
# 운영에서는 KMS/Secrets Manager에서 주입하고 절대 저장소에 두지 마세요.
VAULT_MASTER_KEY="change-me-to-another-long-random-secret"

# 비공개 파일 보관 경로 (로컬 볼트). 운영에서는 S3/R2 어댑터로 교체 권장.
VAULT_DIR="./.vault"

# 결제 사업자 (현재 mockpg 만 구현)
PG_PROVIDER="mockpg"
MOCKPG_WEBHOOK_SECRET="change-me-webhook-signing-secret"

# 로그: "1" 이면 Prisma 경고 로그 출력
# PRISMA_LOG="1"

# Next.js 공개 도메인 (메타데이터 base URL)
# NEXT_PUBLIC_SITE_URL="https://devvault.kr"

# (참고) 실제 PG 연동 시 필요한 값 예시 — 현재 코드는 사용하지 않습니다.
# TOSS_SECRET_KEY=""
# TOSS_WEBHOOK_SECRET=""

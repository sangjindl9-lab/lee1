<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 앱별 도우미 제외 목록에서 설치된 앱(실행 아이콘이 있는 앱) 이름을 보여주기 위함 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eum">

        <activity android:name=".ui.MainActivity" android:exported="true" android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.ClipEditActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.TemplateFillActivity" android:exported="false" android:windowSoftInputMode="adjustResize"
            android:excludeFromRecents="true" android:taskAffinity="" />
        <activity android:name=".ui.OcrActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ImageEditActivity" android:exported="false" />
        <activity android:name=".ui.ImportClipActivity" android:exported="false" android:theme="@style/Theme.Eum.Transparent"
            android:excludeFromRecents="true" android:taskAffinity="" android:noHistory="true" />
        <activity android:name=".ui.ShareReceiveActivity" android:exported="true" android:theme="@style/Theme.Eum.Transparent"
            android:excludeFromRecents="true" android:taskAffinity="" android:label="이음 퀵도우미에 저장">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="이음 퀵도우미 글자 추출">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <service android:name=".service.HelperService" android:exported="true" android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_config" />
        </service>

        <service android:name=".ime.EumKeyboard" android:exported="true" android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>

        <service android:name=".service.QuickTile" android:exported="true" android:label="@string/tile_label"
            android:icon="@drawable/ic_tile" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver android:name=".service.ActionReceiver" android:exported="false" />
    </application>
</manifest>

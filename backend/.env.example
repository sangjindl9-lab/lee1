# PostgreSQL (운영) — 비우면 SQLite(data/app.db) 사용
DATABASE_URL=postgresql://naeyeok:naeyeok@db:5432/naeyeok
# JWT 서명 키 (반드시 변경)
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=720
# 업로드 파일 저장 경로
STORAGE_DIR=/data/files
# 최초 관리자 계정 (첫 실행 시 생성)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
# 허용 CORS (프론트가 같은 서버에서 서빙되면 * 그대로 가능)
CORS_ORIGINS=*
MAX_UPLOAD_MB=100

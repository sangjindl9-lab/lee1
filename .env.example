# ── 필수 ─────────────────────────────────────────────────────────────
SECRET_KEY=여기에-48자-이상-무작위-문자열          # 로그인 토큰 서명. 바꾸면 모두 다시 로그인
ENCRYPTION_KEY=                                  # API 키 암호화용 Fernet 키. python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DATABASE_URL=postgresql://sf:sf@postgres:5432/sf
PUBLIC_BASE_URL=http://localhost:8000            # 브라우저에서 보이는 백엔드 주소(파일 링크·OAuth 리디렉션에 사용)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000        # 프론트 빌드 인자

# ── 작업 실행 ────────────────────────────────────────────────────────
TASK_MODE=celery                                 # celery(운영: 워커 분리) | inline(단일 서버)
REDIS_URL=redis://redis:6379/0

# ── 저장소 ───────────────────────────────────────────────────────────
STORAGE_BACKEND=local                            # local | s3  (서비스를 여러 대로 나누면 반드시 s3)
STORAGE_DIR=/data/storage
WORK_DIR=/data/work
S3_ENDPOINT=                                     # Cloudflare R2: https://<계정ID>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ── 관리자 계정(최초 기동 시 1회 생성) ───────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                                  # 반드시 지정. 비어 있으면 관리자 계정을 만들지 않습니다

# ── 선택 ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                                # 관리자 화면(API 연결 관리)에서 등록해도 됨
GOOGLE_CLIENT_SECRET=
SUBTITLE_FONT=Noto Sans CJK KR
# 외부 AI·검색·YouTube API 키는 환경변수가 아니라 로그인 후 'API 연결 관리' 화면에서 등록합니다(서버에서 암호화 저장).

# SS-ERP API 개발용 환경설정 — 운영은 deploy/.env.example 사용
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp

# 필드 암호화 키 (64자리 16진수) — openssl rand -hex 32
APP_ENCRYPTION_KEY=

WEB_ORIGIN=http://localhost:3000
# 개발(http)에서만 false. 운영은 반드시 true (HTTPS)
COOKIE_SECURE=false
TRUST_PROXY=false

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15

FILE_STORAGE=local
FILE_STORAGE_PATH=./storage
FILE_MAX_MB=20

# ── 백업 (관리 > 백업, 시스템관리자 전용) ──
# 기본 위치: FILE_STORAGE_PATH 옆의 backups 폴더
# BACKUP_DIR=./backups
BACKUP_KEEP=14
BACKUP_HOUR=3
# 화면 쪽 자동 백업을 끄려면 false (서버 백업 스크립트를 따로 쓰는 경우)
BACKUP_AUTO=true

# ── API 문서 (/api/docs) — 개발 환경에서는 항상 열림 ──
SWAGGER_ENABLED=false

# ── 웹훅 ── 개발 중 사내망 주소(localhost 등)로 시험 발송할 때만 true. 운영에서는 절대 켜지 마세요
WEBHOOK_ALLOW_PRIVATE=false

# 외부 연동 키(팝빌·CODEF·공공데이터포털·OCR)는 이 파일이 아니라
# 화면의 '관리 > 외부 연동' 에서 넣습니다 (암호화되어 DB 에 저장).

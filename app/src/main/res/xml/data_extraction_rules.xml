<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : Google 계정 자동 백업·기기 이전 시 노트 DB·첨부·버전 기록 포함 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="attachments/" />
        <include domain="file" path="versions/" />
        <include domain="sharedpref" path="notepro.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

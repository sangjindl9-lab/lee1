# ===== 기본 =====
PORT=3000
# DB(cctv.db)·업로드 파일 저장 위치. 서버 백업 시 이 폴더 전체를 보관하세요.
DATA_DIR=./data
# 세션 암호화 키 (미지정 시 최초 실행 때 자동 생성되어 DB에 저장)
SESSION_SECRET=
# HTTPS(역방향 프록시 포함)로 운영할 때 1
COOKIE_SECURE=0
# QR 코드에 넣을 외부 접속 주소 (예: https://cctv.example.co.kr). 미지정 시 요청 주소 사용
PUBLIC_URL=

# ===== 최초 관리자 (DB에 사용자가 없을 때만 사용) =====
ADMIN_USER=admin
# 비우면 임의 비밀번호를 생성하여 서버 로그에 1회 출력
ADMIN_PASSWORD=
INIT_COMPANY=에스에스전력

# ===== 업로드·변환 =====
MAX_UPLOAD_MB=200
# PDF 페이지를 배경 이미지로 변환할 해상도
PDF_RENDER_DPI=150
# DWG 변환 엔진 (관리자 화면에서도 설정 가능). libredwg | oda
DWG_ENGINE_TYPE=libredwg
DWG_ENGINE_PATH=/opt/libredwg/bin/dwg2dxf

# 복사해서 .env 로 저장 후 수정
DB_PASSWORD=change-me-strong
# openssl rand -hex 32 로 생성. 분실 시 저장된 비밀정보(MFA·장치키)를 복호화할 수 없으니 별도 보관
MASTER_KEY=
JWT_SECRET=
# 장치가 접속할 브로커 주소 (인증서에 들어감, 쉼표로 여러 개)
BROKER_HOSTS=mqtt.local,10.0.0.10
MQTT_PUBLIC_HOST=10.0.0.10
# 최초 1회 중앙 관리자 생성 (생성 후 지우기)
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=
# 웹 포트를 바인딩할 주소 (기본: 이 서버 내부에서만)
HTTP_BIND=127.0.0.1

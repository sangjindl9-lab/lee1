# 웹 NVR 환경변수 예시 — .env 로 복사해 수정하세요. (비밀번호·키는 여기에 넣지 않고 secrets/ 파일로 관리)

# ── 접속 주소·HTTPS ─────────────────────────────────────────
# 브라우저 주소창에 입력할 주소. 도메인이 있으면 도메인(Let's Encrypt 자동 발급),
# 사내망 전용이면 서버 IP 또는 사내 호스트명. 여러 개는 "192.168.0.10, nvr.company.local" 처럼 따옴표로 묶어 쉼표+공백 구분
NVR_SITE_ADDRESS=192.168.0.10
# internal = Caddy 내부 인증서(브라우저 경고 → 사내 배포 시 루트 인증서 신뢰 등록), 도메인 사용 시 관리자 이메일
NVR_TLS=internal

# ── WebRTC ──────────────────────────────────────────────────
# 브라우저가 이 서버에 닿는 주소(서버 LAN IP, 공인 IP 또는 도메인). 쉼표 구분. 비우면 외부망 시청이 안 될 수 있음
NVR_PUBLIC_HOSTS=192.168.0.10
# UDP 8189 가 막힌 망이면 true + docker-compose.yml 의 8189/tcp 포트 주석 해제
NVR_WEBRTC_TCP=false
# 외부망 시청 시 STUN 서버(쉼표 구분). 사내망 전용이면 비워 둡니다. 예: stun:stun.l.google.com:19302
NVR_STUN_SERVERS=

# ── 저장 위치(호스트 경로) ──────────────────────────────────
# 녹화 전용 디스크를 마운트한 경로를 지정하세요. UID 10001 이 쓸 수 있어야 합니다.
NVR_RECORDINGS_HOST_PATH=./data/recordings
NVR_EXPORTS_HOST_PATH=./data/exports

# ── 녹화·보관 기본값 ────────────────────────────────────────
NVR_SEGMENT_SECONDS=60
NVR_DEFAULT_RETENTION_DAYS=30
NVR_MIN_FREE_PERCENT=10
NVR_MIN_FREE_GB=20
NVR_EXPORT_TTL_HOURS=24
NVR_EXPORT_MAX_MINUTES=240

# ── 세션·로그인 보호 ────────────────────────────────────────
NVR_COOKIE_SECURE=true
NVR_SESSION_IDLE_MINUTES=60
NVR_SESSION_ABSOLUTE_HOURS=12
NVR_LIVE_TOKEN_SECONDS=600
NVR_LOGIN_MAX_FAIL_USER=5
NVR_LOGIN_MAX_FAIL_IP=20
NVR_LOGIN_WINDOW_MINUTES=15

NVR_API_WORKERS=2
NVR_LOG_LEVEL=INFO

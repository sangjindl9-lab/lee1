# 복사해서 .env 로 저장 후 값을 바꾸세요. (.env 는 저장소에 올리지 않습니다)

# 서버 포트
PORT=3000

# 세션 서명 키 — 반드시 길고 임의의 값으로 변경 (예: openssl rand -hex 32)
SESSION_SECRET=change-this-to-a-long-random-string

# 데이터 폴더 (DB·첨부파일). 운영 시 백업 대상
DATA_DIR=./data
# 개별 지정 시
# DB_PATH=./data/app.db
# UPLOAD_DIR=./data/uploads

# 업로드 최대 크기 (MB)
MAX_UPLOAD_MB=50

# QR 코드에 넣을 외부 접속 주소 (예: https://cable.example.co.kr). 비우면 접속한 주소 사용
PUBLIC_BASE_URL=

# HTTPS 로만 서비스할 때 true (쿠키 Secure)
COOKIE_SECURE=false

# PDF 생성용 Chromium 경로 (비우면 Playwright 기본 브라우저)
CHROMIUM_PATH=

# 최초 관리자 계정 (npm run init 실행 시 사용)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 시연 계정 비밀번호 (npm run seed:demo 실행 시 사용)
DEMO_PASSWORD=
